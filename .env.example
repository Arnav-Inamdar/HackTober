# AVIA talks only to your local Ollama service.
OLLAMA_BASE_URL=http://localhost:11434

# Optional. If sharing AVIA, set an identifiable Wikimedia User-Agent with a real contact address/URL.
# WIKIMEDIA_USER_AGENT=AVIA-LocalQuiz/1.0 (mailto:you@example.com)

# The FastAPI service accepts browser requests only from the local Vite app.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override the Vite dev proxy target when the API runs elsewhere locally.
# AVIA_API_PROXY_TARGET=http://127.0.0.1:8000
